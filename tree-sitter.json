{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "pug",
      "camelcase": "Pug",
      "title": "Pug",
      "scope": "source.pug",
      "file-types": [
        "pug"
      ],
      "injection-regex": "^pug$",
      "class-name": "TreeSitterPug"
    }
  ],
  "metadata": {
    "version": "1.0.12",
    "license": "MIT",
    "description": "Pug grammar for tree-sitter",
    "authors": [],
    "links": {
      "repository": "https://github.com/zealot128/tree-sitter-pug"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
